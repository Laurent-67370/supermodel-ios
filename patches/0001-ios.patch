+
+/*
+ * GL/glew.h (OpenGL ES 3.0 builds, SUPERMODEL_GLES)
+ *
+ * Takes the place of GLEW where only OpenGL ES 3.0 exists (iOS): the
+ * functions come straight from the system's library, the few of desktop
+ * OpenGL the Model 3 renderers use are mapped onto their OpenGL ES
+ * equivalents, and the shaders, written for GLSL 4.10, are translated to
+ * GLSL ES 3.00 as they are handed to OpenGL (glShaderSource below).
+ *
+ * What OpenGL ES 3.0 lacks entirely (geometry shaders, texture buffers) is
+ * stubbed: the Model 1/2 renderer and the quad rendering of New3D, which
+ * need them, are not available.
+ */
+
+#ifndef INCLUDED_SUPERMODEL_GLES_GLEW_H
+#define INCLUDED_SUPERMODEL_GLES_GLEW_H
+
+#if defined(__APPLE__)
+#  include <OpenGLES/ES3/gl.h>
+#  include <OpenGLES/ES3/glext.h>
+#else
+#  include <GLES3/gl3.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* GLEW's start-up: nothing to load */
+#define GLEW_OK 0
+#define glewExperimental sm_gles_glewExperimental
+extern GLboolean sm_gles_glewExperimental;
+static inline GLenum glewInit(void) { return GLEW_OK; }
+static inline const GLubyte *glewGetErrorString(GLenum error) { (void)error; return (const GLubyte *)"no error"; }
+
+/* Desktop OpenGL's names that OpenGL ES 3.0 has not */
+#ifndef GL_BGRA
+#define GL_BGRA 0x80E1
+#endif
+#define GL_UNSIGNED_INT_8_8_8_8_REV 0x8367
+#define GL_FRAMEBUFFER_SRGB 0x8DB9
+#define GL_GEOMETRY_SHADER 0x8DD9
+#define GL_LINES_ADJACENCY 0x000A
+#define GL_TEXTURE_BUFFER 0x8C2A
+#define GL_CONTEXT_PROFILE_MASK 0x9126
+#define GL_CONTEXT_CORE_PROFILE_BIT 0x00000001
+#define GL_CONTEXT_COMPATIBILITY_PROFILE_BIT 0x00000002
+#define GL_DEBUG_OUTPUT 0x92E0
+#define GL_DEBUG_OUTPUT_SYNCHRONOUS 0x8242
+#define GL_MODELVIEW 0x1700
+#define GL_PROJECTION 0x1701
+
+typedef void (*GLDEBUGPROC)(GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length,
+                            const GLchar *message, const void *userParam);
+
+static inline void glClearDepth(double depth) { glClearDepthf((GLfloat)depth); }
+
+/* The screen: framebuffer 0 on desktop OpenGL, but on iOS one SDL makes (its
+ * view's), so "0" is that one: noted when the context is made current
+ * (sm_gles_NoteDefaultFramebuffer), then given for 0 */
+extern GLuint sm_gles_defaultFramebuffer;
+void sm_gles_NoteDefaultFramebuffer(void);
+/* Before the frame is shown (SDL_GL_SwapWindow): on iOS SDL presents the
+ * renderbuffer bound, which must be the screen's colour, not the renderers'
+ * (New3D binds its depth's) */
+void sm_gles_BeforeSwap(void);
+void sm_gles_BindFramebuffer(GLenum target, GLuint framebuffer);
+#define glBindFramebuffer sm_gles_BindFramebuffer
+/* GL_BACK names the screen's only when it is framebuffer 0 */
+void sm_gles_DrawBuffer(GLenum buffer);
+#define glDrawBuffer sm_gles_DrawBuffer
+static inline void glTexBuffer(GLenum target, GLenum format, GLuint buffer) { (void)target; (void)format; (void)buffer; }
+static inline void glDebugMessageCallback(GLDEBUGPROC callback, const void *user) { (void)callback; (void)user; }
+static inline void glDebugMessageControl(GLenum source, GLenum type, GLenum severity, GLsizei count, const GLuint *ids,
+                                         GLboolean enabled)
+{
+	(void)source; (void)type; (void)severity; (void)count; (void)ids; (void)enabled;
+}
+
+/* BGRA texels (desktop OpenGL) as RGBA, red and blue swapped when read */
+void sm_gles_TexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height,
+  GLint border, GLenum format, GLenum type, const void *pixels);
+void sm_gles_TexSubImage2D(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width,
+  GLsizei height, GLenum format, GLenum type, const void *pixels);
+
+/* The shaders, GLSL 4.10, given to OpenGL as GLSL ES 3.00 */
+void sm_gles_ShaderSource(GLuint shader, GLsizei count, const GLchar *const *string, const GLint *length);
+#define glShaderSource sm_gles_ShaderSource
+/* A shader that does not compile: its errors in the log (Supermodel.log) */
+void sm_gles_CompileShader(GLuint shader);
+#define glCompileShader sm_gles_CompileShader
+
+
+/* A program that does not link: its errors in the log */
+void sm_gles_LinkProgram(GLuint program);
+#define glLinkProgram sm_gles_LinkProgram
+
+/* The OpenGL errors of the first frames, each with the call and the place
+ * that made it, in the log (Supermodel.log): what desktop OpenGL accepts and
+ * OpenGL ES does not shows there. sm_gles_frames_checked frames are checked
+ * (sm_gles_EndFrame counts them), the first errors logged */
+void sm_gles_Check(const char *call, const char *file, int line);
+void sm_gles_EndFrame(void);
+#ifndef SM_GLES_NO_CHECKS
+#define glUniform1i(...) (glUniform1i(__VA_ARGS__), sm_gles_Check("glUniform1i", __FILE__, __LINE__))
+#define glBindVertexArray(...) (glBindVertexArray(__VA_ARGS__), sm_gles_Check("glBindVertexArray", __FILE__, __LINE__))
+#define glBindTexture(...) (glBindTexture(__VA_ARGS__), sm_gles_Check("glBindTexture", __FILE__, __LINE__))
+#define glTexParameteri(...) (glTexParameteri(__VA_ARGS__), sm_gles_Check("glTexParameteri", __FILE__, __LINE__))
+#define glDisable(...) (glDisable(__VA_ARGS__), sm_gles_Check("glDisable", __FILE__, __LINE__))
+#define glEnableVertexAttribArray(...) (glEnableVertexAttribArray(__VA_ARGS__), sm_gles_Check("glEnableVertexAttribArray", __FILE__, __LINE__))
+#define glVertexAttribPointer(...) (glVertexAttribPointer(__VA_ARGS__), sm_gles_Check("glVertexAttribPointer", __FILE__, __LINE__))
+#define glActiveTexture(...) (glActiveTexture(__VA_ARGS__), sm_gles_Check("glActiveTexture", __FILE__, __LINE__))
+#define glBindBuffer(...) (glBindBuffer(__VA_ARGS__), sm_gles_Check("glBindBuffer", __FILE__, __LINE__))
+#define glViewport(...) (glViewport(__VA_ARGS__), sm_gles_Check("glViewport", __FILE__, __LINE__))
+#define glUseProgram(...) (glUseProgram(__VA_ARGS__), sm_gles_Check("glUseProgram", __FILE__, __LINE__))
+#define glEnable(...) (glEnable(__VA_ARGS__), sm_gles_Check("glEnable", __FILE__, __LINE__))
+#define glUniform1f(...) (glUniform1f(__VA_ARGS__), sm_gles_Check("glUniform1f", __FILE__, __LINE__))
+#define glAttachShader(...) (glAttachShader(__VA_ARGS__), sm_gles_Check("glAttachShader", __FILE__, __LINE__))
+#define glTexImage2D(...) (sm_gles_TexImage2D(__VA_ARGS__), sm_gles_Check("glTexImage2D", __FILE__, __LINE__))
+#define glClear(...) (glClear(__VA_ARGS__), sm_gles_Check("glClear", __FILE__, __LINE__))
+#define glScissor(...) (glScissor(__VA_ARGS__), sm_gles_Check("glScissor", __FILE__, __LINE__))
+#define glPixelStorei(...) (glPixelStorei(__VA_ARGS__), sm_gles_Check("glPixelStorei", __FILE__, __LINE__))
+#define glUniform2f(...) (glUniform2f(__VA_ARGS__), sm_gles_Check("glUniform2f", __FILE__, __LINE__))
+#define glTexSubImage2D(...) (sm_gles_TexSubImage2D(__VA_ARGS__), sm_gles_Check("glTexSubImage2D", __FILE__, __LINE__))
+#define glDrawArrays(...) (glDrawArrays(__VA_ARGS__), sm_gles_Check("glDrawArrays", __FILE__, __LINE__))
+#define glUniform4f(...) (glUniform4f(__VA_ARGS__), sm_gles_Check("glUniform4f", __FILE__, __LINE__))
+#define glStencilOp(...) (glStencilOp(__VA_ARGS__), sm_gles_Check("glStencilOp", __FILE__, __LINE__))
+#define glStencilMask(...) (glStencilMask(__VA_ARGS__), sm_gles_Check("glStencilMask", __FILE__, __LINE__))
+#define glStencilFunc(...) (glStencilFunc(__VA_ARGS__), sm_gles_Check("glStencilFunc", __FILE__, __LINE__))
+#define glUniformMatrix4fv(...) (glUniformMatrix4fv(__VA_ARGS__), sm_gles_Check("glUniformMatrix4fv", __FILE__, __LINE__))
+#define glUniform3fv(...) (glUniform3fv(__VA_ARGS__), sm_gles_Check("glUniform3fv", __FILE__, __LINE__))
+#define glFramebufferTexture2D(...) (glFramebufferTexture2D(__VA_ARGS__), sm_gles_Check("glFramebufferTexture2D", __FILE__, __LINE__))
+#define glBufferData(...) (glBufferData(__VA_ARGS__), sm_gles_Check("glBufferData", __FILE__, __LINE__))
+#define glReadPixels(...) (glReadPixels(__VA_ARGS__), sm_gles_Check("glReadPixels", __FILE__, __LINE__))
+#define glBlendFunc(...) (glBlendFunc(__VA_ARGS__), sm_gles_Check("glBlendFunc", __FILE__, __LINE__))
+#define glBindRenderbuffer(...) (glBindRenderbuffer(__VA_ARGS__), sm_gles_Check("glBindRenderbuffer", __FILE__, __LINE__))
+#define glUniform1uiv(...) (glUniform1uiv(__VA_ARGS__), sm_gles_Check("glUniform1uiv", __FILE__, __LINE__))
+#define glRenderbufferStorage(...) (glRenderbufferStorage(__VA_ARGS__), sm_gles_Check("glRenderbufferStorage", __FILE__, __LINE__))
+#define glReadBuffer(...) (glReadBuffer(__VA_ARGS__), sm_gles_Check("glReadBuffer", __FILE__, __LINE__))
+#define glFramebufferRenderbuffer(...) (glFramebufferRenderbuffer(__VA_ARGS__), sm_gles_Check("glFramebufferRenderbuffer", __FILE__, __LINE__))
+#define glDrawBuffers(...) (glDrawBuffers(__VA_ARGS__), sm_gles_Check("glDrawBuffers", __FILE__, __LINE__))
+#define glDepthMask(...) (glDepthMask(__VA_ARGS__), sm_gles_Check("glDepthMask", __FILE__, __LINE__))
+#define glBufferSubData(...) (glBufferSubData(__VA_ARGS__), sm_gles_Check("glBufferSubData", __FILE__, __LINE__))
+#define glVertexAttribIPointer(...) (glVertexAttribIPointer(__VA_ARGS__), sm_gles_Check("glVertexAttribIPointer", __FILE__, __LINE__))
+#define glUniform4i(...) (glUniform4i(__VA_ARGS__), sm_gles_Check("glUniform4i", __FILE__, __LINE__))
+#define glUniform4fv(...) (glUniform4fv(__VA_ARGS__), sm_gles_Check("glUniform4fv", __FILE__, __LINE__))
+#define glUniform2iv(...) (glUniform2iv(__VA_ARGS__), sm_gles_Check("glUniform2iv", __FILE__, __LINE__))
+#define glUniform2fv(...) (glUniform2fv(__VA_ARGS__), sm_gles_Check("glUniform2fv", __FILE__, __LINE__))
+#define glDepthFunc(...) (glDepthFunc(__VA_ARGS__), sm_gles_Check("glDepthFunc", __FILE__, __LINE__))
+#define glCopyTexSubImage2D(...) (glCopyTexSubImage2D(__VA_ARGS__), sm_gles_Check("glCopyTexSubImage2D", __FILE__, __LINE__))
+#define glClearStencil(...) (glClearStencil(__VA_ARGS__), sm_gles_Check("glClearStencil", __FILE__, __LINE__))
+#define glBlitFramebuffer(...) (glBlitFramebuffer(__VA_ARGS__), sm_gles_Check("glBlitFramebuffer", __FILE__, __LINE__))
