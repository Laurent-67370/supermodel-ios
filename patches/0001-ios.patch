diff --git a/Src/OSD/GLES/GL/glew.h b/Src/OSD/GLES/GL/glew.h
new file mode 100644
index 0000000..defc60b
--- /dev/null
+++ b/Src/OSD/GLES/GL/glew.h
@@ -0,0 +1,94 @@
+/**
+ ** Supermodel
+ ** A Sega Model 3 Arcade Emulator.
+ **
+ ** This file is part of Supermodel.
+ **
+ ** Supermodel is free software: you can redistribute it and/or modify it under
+ ** the terms of the GNU General Public License as published by the Free
+ ** Software Foundation, either version 3 of the License, or (at your option)
+ ** any later version.
+ **
+ ** Supermodel is distributed in the hope that it will be useful, but WITHOUT
+ ** ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ ** FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ ** more details.
+ **
+ ** You should have received a copy of the GNU General Public License along
+ ** with Supermodel.  If not, see <http://www.gnu.org/licenses/>.
+ **/
+
+/*
+ * GL/glew.h (OpenGL ES 3.0 builds, SUPERMODEL_GLES)
+ *
+ * Takes the place of GLEW where only OpenGL ES 3.0 exists (iOS): the
+ * functions come straight from the system's library, the few of desktop
+ * OpenGL the Model 3 renderers use are mapped onto their OpenGL ES
+ * equivalents, and the shaders, written for GLSL 4.10, are translated to
+ * GLSL ES 3.00 as they are handed to OpenGL (glShaderSource below).
+ *
+ * What OpenGL ES 3.0 lacks entirely (geometry shaders, texture buffers) is
+ * stubbed: the Model 1/2 renderer and the quad rendering of New3D, which
+ * need them, are not available.
+ */
+
+#ifndef INCLUDED_SUPERMODEL_GLES_GLEW_H
+#define INCLUDED_SUPERMODEL_GLES_GLEW_H
+
+#if defined(__APPLE__)
+#  include <OpenGLES/ES3/gl.h>
+#  include <OpenGLES/ES3/glext.h>
+#else
+#  include <GLES3/gl3.h>
+#endif
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* GLEW's start-up: nothing to load */
+#define GLEW_OK 0
+#define glewExperimental sm_gles_glewExperimental
+extern GLboolean sm_gles_glewExperimental;
+static inline GLenum glewInit(void) { return GLEW_OK; }
+static inline const GLubyte *glewGetErrorString(GLenum error) { (void)error; return (const GLubyte *)"no error"; }
+
+/* Desktop OpenGL's names that OpenGL ES 3.0 has not */
+#ifndef GL_BGRA
+#define GL_BGRA 0x80E1
+#endif
+#define GL_UNSIGNED_INT_8_8_8_8_REV 0x8367
+#define GL_FRAMEBUFFER_SRGB 0x8DB9
+#define GL_GEOMETRY_SHADER 0x8DD9
+#define GL_LINES_ADJACENCY 0x000A
+#define GL_TEXTURE_BUFFER 0x8C2A
+#define GL_CONTEXT_PROFILE_MASK 0x9126
+#define GL_CONTEXT_CORE_PROFILE_BIT 0x00000001
+#define GL_CONTEXT_COMPATIBILITY_PROFILE_BIT 0x00000002
+#define GL_DEBUG_OUTPUT 0x92E0
+#define GL_DEBUG_OUTPUT_SYNCHRONOUS 0x8242
+#define GL_MODELVIEW 0x1700
+#define GL_PROJECTION 0x1701
+
+typedef void (*GLDEBUGPROC)(GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length,
+                            const GLchar *message, const void *userParam);
+
+static inline void glClearDepth(double depth) { glClearDepthf((GLfloat)depth); }
+static inline void glDrawBuffer(GLenum buffer) { glDrawBuffers(1, &buffer); }
+static inline void glTexBuffer(GLenum target, GLenum format, GLuint buffer) { (void)target; (void)format; (void)buffer; }
+static inline void glDebugMessageCallback(GLDEBUGPROC callback, const void *user) { (void)callback; (void)user; }
+static inline void glDebugMessageControl(GLenum source, GLenum type, GLenum severity, GLsizei count, const GLuint *ids,
+                                         GLboolean enabled)
+{
+	(void)source; (void)type; (void)severity; (void)count; (void)ids; (void)enabled;
+}
+
+/* The shaders, GLSL 4.10, given to OpenGL as GLSL ES 3.00 */
+void sm_gles_ShaderSource(GLuint shader, GLsizei count, const GLchar *const *string, const GLint *length);
+#define glShaderSource sm_gles_ShaderSource
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* INCLUDED_SUPERMODEL_GLES_GLEW_H */
diff --git a/Src/OSD/GLES/GLES.cpp b/Src/OSD/GLES/GLES.cpp
new file mode 100644
index 0000000..51eacaa
--- /dev/null
+++ b/Src/OSD/GLES/GLES.cpp
@@ -0,0 +1,106 @@
+/**
+ ** Supermodel
+ ** A Sega Model 3 Arcade Emulator.
+ **
+ ** This file is part of Supermodel.
+ **
+ ** Supermodel is free software: you can redistribute it and/or modify it under
+ ** the terms of the GNU General Public License as published by the Free
+ ** Software Foundation, either version 3 of the License, or (at your option)
+ ** any later version.
+ **
+ ** Supermodel is distributed in the hope that it will be useful, but WITHOUT
+ ** ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ ** FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ ** more details.
+ **
+ ** You should have received a copy of the GNU General Public License along
+ ** with Supermodel.  If not, see <http://www.gnu.org/licenses/>.
+ **/
+
+/*
+ * GLES.cpp (OpenGL ES 3.0 builds, SUPERMODEL_GLES)
+ *
+ * The shaders of the renderers, written for GLSL 4.10 (core profile),
+ * translated to GLSL ES 3.00 as they are given to OpenGL: the "#version"
+ * line becomes "#version 300 es", default precisions follow it (after any
+ * "#extension"), and what GLSL ES does not know is taken out.
+ */
+
+#include "GL/glew.h"
+
+#include <cstdio>
+#include <string>
+
+#undef glShaderSource
+
+GLboolean sm_gles_glewExperimental = GL_FALSE;
+
+namespace
+{
+  const char s_precisions[] =
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "precision highp sampler2D;\n"
+    "precision highp usampler2D;\n"
+    "precision highp isampler2D;\n";
+
+  void ReplaceAll(std::string &text, const std::string &from, const std::string &to)
+  {
+    for (size_t at = text.find(from); at != std::string::npos; at = text.find(from, at + to.size()))
+      text.replace(at, from.size(), to);
+  }
+
+  // Desktop GLSL 4.10 → GLSL ES 3.00
+  std::string Translate(std::string source)
+  {
+    const size_t version = source.find("#version");
+
+    if (version == std::string::npos)
+      return source;
+
+    size_t end = source.find('\n', version);
+    if (end == std::string::npos)
+      end = source.size();
+    source.replace(version, end - version, "#version 300 es");
+    end = source.find('\n', version);
+
+    // The precisions follow the directives that must come first
+    size_t after = (end == std::string::npos) ? source.size() : end + 1;
+    for (;;)
+    {
+      size_t line = after;
+      while (line < source.size() && (source[line] == ' ' || source[line] == '\t'))
+        line++;
+      if (source.compare(line, 10, "#extension") != 0)
+        break;
+      const size_t next = source.find('\n', line);
+      after = (next == std::string::npos) ? source.size() : next + 1;
+    }
+    source.insert(after, s_precisions);
+
+    // Interpolation qualifiers GLSL ES 3.00 lacks (the quads' shaders,
+    // which are not used without geometry shaders)
+    ReplaceAll(source, "noperspective ", "");
+    return source;
+  }
+}
+
+extern "C" void sm_gles_ShaderSource(GLuint shader, GLsizei count, const GLchar *const *string, const GLint *length)
+{
+  std::string source;
+
+  for (GLsizei i = 0; i < count; i++)
+  {
+    if (!string[i])
+      continue;
+    if (length && length[i] >= 0)
+      source.append(string[i], (size_t)length[i]);
+    else
+      source.append(string[i]);
+  }
+  source = Translate(source);
+
+  const GLchar *translated = source.c_str();
+  glShaderSource(shader, 1, &translated, nullptr);
+}
