+// iOS, Android: the menu in French (supermodel-ios, for its users), the
+// English text elsewhere; "label##id" keeps the same ImGui id in both
+#ifdef SUPERMODEL_MOBILE
+#define TR(en, fr) fr
+#else
+#define TR(en, fr) en
+#endif
+
+#ifdef SUPERMODEL_MOBILE
+// iOS, Android: a finger on the menu, as on a phone's own lists. A touch is
+// held back until it is known: a tap (pressed there, then released), a drag
+// mostly up or down (it scrolls the list or the page under it, as a mouse
+// wheel would, and presses nothing: no button, no slider changed on the
+// way), or a drag sideways (pressed where it began: a slider follows the
+// finger). The scrollbars, thin at the very edge of the screen, are not
+// needed. Returns true when the event is not for ImGui.
+static struct
+{
+    bool down = false;
+    int mode = 0;
+    SDL_Event press;
+    int x0 = 0, y0 = 0, lastY = 0;
+} s_touch;
+
+static bool TouchGesture(const SDL_Event &e)
+{
+    enum { kWaiting, kScrolling, kPressing };
+    ImGuiIO &io = ImGui::GetIO();
+
+    if (e.type == SDL_MOUSEBUTTONDOWN && e.button.which == SDL_TOUCH_MOUSEID && e.button.button == SDL_BUTTON_LEFT)
+    {
+        s_touch.down = true;
+        s_touch.mode = kWaiting;
+        s_touch.press = e;
+        s_touch.x0 = e.button.x;
+        s_touch.y0 = s_touch.lastY = e.button.y;
+        // The pointer there (which window is under the finger), not pressed
+        io.AddMouseSourceEvent(ImGuiMouseSource_TouchScreen);
+        io.AddMousePosEvent(float(e.button.x), float(e.button.y));
+        return true;
+    }
+    if (!s_touch.down)
+        return false;
+    if (e.type == SDL_MOUSEMOTION && e.motion.which == SDL_TOUCH_MOUSEID)
+    {
+        if (s_touch.mode == kWaiting)
+        {
+            int dx = e.motion.x - s_touch.x0, dy = e.motion.y - s_touch.y0;
+            float threshold = 8.0f * s_uiScale;
+            if (std::abs(dy) > threshold && std::abs(dy) >= std::abs(dx))
+                s_touch.mode = kScrolling;
+            else if (std::abs(dx) > threshold)
+            {
+                s_touch.mode = kPressing;
+                ImGui_ImplSDL2_ProcessEvent(&s_touch.press);
+            }
+            else
+                return true;
+        }
+        if (s_touch.mode == kScrolling)
+        {
+            // A wheel's step is about five lines (ImGui): the page follows
+            // the finger
+            float step = 5.0f * (GImGui->FontSize > 0.0f ? GImGui->FontSize : 13.0f * s_uiScale);
+            io.AddMouseWheelEvent(0.0f, float(e.motion.y - s_touch.lastY) / step);
+            s_touch.lastY = e.motion.y;
+            return true;
+        }
+        return false;
+    }
+    if (e.type == SDL_MOUSEBUTTONUP && e.button.which == SDL_TOUCH_MOUSEID && e.button.button == SDL_BUTTON_LEFT)
+    {
+        s_touch.down = false;
+        if (s_touch.mode == kWaiting)
+        {
+            // A tap: the press, then this release (in turn, frame by frame)
+            ImGui_ImplSDL2_ProcessEvent(&s_touch.press);
+            return false;
+        }
+        return s_touch.mode == kScrolling;
+    }
+    return false;
+}
