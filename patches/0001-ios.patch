+ ** ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or
+ ** FITNESS FOR A PARTICULAR PURPOSE.  See the GNU General Public License for
+ ** more details.
+ **
+ ** You should have received a copy of the GNU General Public License along
+ ** with Supermodel.  If not, see <http://www.gnu.org/licenses/>.
+ **/
+
+/*
+ * GLES.cpp (OpenGL ES 3.0 builds, SUPERMODEL_GLES)
+ *
+ * The shaders of the renderers, written for GLSL 4.10 (core profile),
+ * translated to GLSL ES 3.00 as they are given to OpenGL: the "#version"
+ * line becomes "#version 300 es", default precisions follow it (after any
+ * "#extension"), and what GLSL ES does not know is taken out.
+ */
+
+#define SM_GLES_NO_CHECKS
+#include "GL/glew.h"
+#include "OSD/Logger.h"
+
+#include <cstdio>
+#include <cstring>
+#include <cctype>
+#include <string>
+
+#undef glShaderSource
+#undef glCompileShader
+#undef glBindFramebuffer
+#undef glDrawBuffer
+#undef glTexImage2D
+#undef glTexSubImage2D
+#undef glLinkProgram
+
+GLboolean sm_gles_glewExperimental = GL_FALSE;
+GLuint sm_gles_defaultFramebuffer = 0;
+static GLuint s_screenColour = 0;	// the screen framebuffer's colour renderbuffer, iOS
+
+namespace
+{
+  const char s_precisions[] =
+    "precision highp float;\n"
+    "precision highp int;\n"
+    "precision highp sampler2D;\n"
+    "precision highp usampler2D;\n"
+    "precision highp isampler2D;\n";
+
+  void ReplaceAll(std::string &text, const std::string &from, const std::string &to)
+  {
+    for (size_t at = text.find(from); at != std::string::npos; at = text.find(from, at + to.size()))
+      text.replace(at, from.size(), to);
+  }
+
+  // Desktop GLSL 4.10 → GLSL ES 3.00
+  std::string Translate(std::string source)
+  {
+    const size_t version = source.find("#version");
+
+    if (version == std::string::npos)
+      return source;
+
+    size_t end = source.find('\n', version);
+    if (end == std::string::npos)
+      end = source.size();
+    source.replace(version, end - version, "#version 300 es");
+    end = source.find('\n', version);
+
+    // The precisions follow the directives that must come first
+    size_t after = (end == std::string::npos) ? source.size() : end + 1;
+    for (;;)
+    {
+      size_t line = after;
+      while (line < source.size() && (source[line] == ' ' || source[line] == '\t'))
+        line++;
+      if (source.compare(line, 10, "#extension") != 0)
+        break;
+      const size_t next = source.find('\n', line);
+      after = (next == std::string::npos) ? source.size() : next + 1;
+    }
+    source.insert(after, s_precisions);
+
+    // Interpolation qualifiers GLSL ES 3.00 lacks (the quads' shaders,
+    // which are not used without geometry shaders)
+    ReplaceAll(source, "noperspective ", "");
+
+    // Buffer textures (GLSL ES 3.20): integer 2D textures 256 texels wide
+    // instead, a texel i at (i % 256, i / 256) (the Model 1/2 renderer makes
+    // them so in OpenGL ES; Model1Render.cpp)
+    bool buffers = false;
+    for (size_t at = source.find("usamplerBuffer"); at != std::string::npos; at = source.find("usamplerBuffer", at))
+    {
+      size_t name = at + 14;
+      while (name < source.size() && (source[name] == ' ' || source[name] == '\t'))
+        name++;
+      size_t end = name;
+      while (end < source.size() && (isalnum((unsigned char)source[end]) || source[end] == '_'))
+        end++;
+      const std::string id = source.substr(name, end - name);
+      source.replace(at, 14, "highp usampler2D");
+      at += 16;
+      if (!id.empty())
+        ReplaceAll(source, "texelFetch(" + id + ",", "sm_texelFetchBuffer(" + id + ",");
+      buffers = true;
+    }
+    std::string helpers;
+    if (buffers)
+      helpers += "uvec4 sm_texelFetchBuffer(highp usampler2D s, int i) { return texelFetch(s, ivec2(i & 255, i >> 8), 0); }\n";
+
+    // findMSB (GLSL ES 3.10): the same, in GLSL ES 3.00
+    if (source.find("findMSB(") != std::string::npos)
+    {
+      ReplaceAll(source, "findMSB(", "sm_findMSB(");
+      helpers +=
+        "int sm_findMSB(uint v) { if (v == 0u) return -1; int r = 0;"
+        " if (v >= 0x10000u) { v >>= 16; r += 16; } if (v >= 0x100u) { v >>= 8; r += 8; }"
+        " if (v >= 0x10u) { v >>= 4; r += 4; } if (v >= 0x4u) { v >>= 2; r += 2; }"
+        " if (v >= 0x2u) r += 1; return r; }\n"
+        "int sm_findMSB(int v) { return sm_findMSB(uint(v < 0 ? ~v : v)); }\n";
+    }
+    if (!helpers.empty())
+    {
+      const size_t precisions = source.find(s_precisions);
+      if (precisions != std::string::npos)
+        source.insert(precisions + sizeof(s_precisions) - 1, helpers);
+    }
+    return source;
+  }
+}
+
+extern "C" void sm_gles_ShaderSource(GLuint shader, GLsizei count, const GLchar *const *string, const GLint *length)
+{
+  std::string source;
+
+  for (GLsizei i = 0; i < count; i++)
+  {
+    if (!string[i])
+      continue;
+    if (length && length[i] >= 0)
+      source.append(string[i], (size_t)length[i]);
+    else
+      source.append(string[i]);
+  }
+  source = Translate(source);
+
+  const GLchar *translated = source.c_str();
+  glShaderSource(shader, 1, &translated, nullptr);
+}
+
+extern "C" void sm_gles_CompileShader(GLuint shader)
+{
+  glCompileShader(shader);
+
+  GLint compiled = GL_FALSE;
+  glGetShaderiv(shader, GL_COMPILE_STATUS, &compiled);
+  if (compiled)
+    return;
+
+  GLint length = 0;
+  glGetShaderiv(shader, GL_INFO_LOG_LENGTH, &length);
+  std::string log(length > 0 ? (size_t)length : 1, '\0');
+  glGetShaderInfoLog(shader, (GLsizei)log.size(), nullptr, &log[0]);
+  ErrorLog("OpenGL ES: a shader does not compile: %s", log.c_str());
+}
+
+extern "C" void sm_gles_NoteDefaultFramebuffer(void)
+{
+  GLint bound = 0;
+  glGetIntegerv(GL_FRAMEBUFFER_BINDING, &bound);
+  sm_gles_defaultFramebuffer = (GLuint)bound;
+
+  // Its colour, a renderbuffer, when the screen is a framebuffer object
+  // (iOS): SDL presents the renderbuffer bound when the frame is shown
+  GLint type = GL_NONE, name = 0;
+  if (bound)
+  {
+    glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+    if (type == GL_RENDERBUFFER)
+      glGetFramebufferAttachmentParameteriv(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &name);
+  }
+  s_screenColour = (GLuint)name;
+  InfoLog("OpenGL ES: the screen is framebuffer %d, its colour renderbuffer %d", bound, name);
+}
+
+extern "C" void sm_gles_BeforeSwap(void)
+{
+  if (s_screenColour)
+    glBindRenderbuffer(GL_RENDERBUFFER, s_screenColour);
+}
+
+extern "C" void sm_gles_BindFramebuffer(GLenum target, GLuint framebuffer)
+{
+  glBindFramebuffer(target, framebuffer ? framebuffer : sm_gles_defaultFramebuffer);
+}
+
+extern "C" void sm_gles_DrawBuffer(GLenum buffer)
+{
+  GLint bound = 0;
+  glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &bound);
+  // The screen made by SDL (iOS) is a framebuffer object: its colour is
+  // attachment 0, not GL_BACK
+  if (bound != 0 && buffer == GL_BACK)
+    buffer = GL_COLOR_ATTACHMENT0;
+  glDrawBuffers(1, &buffer);
+}
+
+namespace
+{
+  unsigned s_framesChecked = 0;
+  unsigned s_errorsLogged = 0;
+  const unsigned FRAMES_CHECKED = 300;
+  const unsigned ERRORS_LOGGED = 40;
+
+  const char *Short(const char *file)
+  {
+    const char *src = std::strstr(file, "Src/");
+    return src ? src : file;
+  }
+}
+
+extern "C" void sm_gles_Check(const char *call, const char *file, int line)
+{
+  if (s_framesChecked >= FRAMES_CHECKED || s_errorsLogged >= ERRORS_LOGGED)
+    return;
+  for (GLenum error = glGetError(); error != GL_NO_ERROR; error = glGetError())
+  {
+    if (s_errorsLogged++ < ERRORS_LOGGED)
+      ErrorLog("OpenGL ES: error 0x%x by %s (%s:%d), frame %u", (unsigned)error, call, Short(file), line,
+        s_framesChecked);
+  }
+}
+
+extern "C" void sm_gles_EndFrame(void)
+{
+  if (s_framesChecked < FRAMES_CHECKED)
+    s_framesChecked++;
+}
+
+extern "C" void sm_gles_LinkProgram(GLuint program)
+{
+  glLinkProgram(program);
+
+  GLint linked = GL_FALSE;
+  glGetProgramiv(program, GL_LINK_STATUS, &linked);
+  if (linked)
+    return;
+
+  GLint length = 0;
+  glGetProgramiv(program, GL_INFO_LOG_LENGTH, &length);
+  std::string log(length > 0 ? (size_t)length : 1, '\0');
+  glGetProgramInfoLog(program, (GLsizei)log.size(), nullptr, &log[0]);
+  ErrorLog("OpenGL ES: a program does not link: %s", log.c_str());
+}
+
+// Desktop OpenGL's BGRA texels (GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV: the
+// bytes B, G, R, A of a little-endian 0xAARRGGBB) as RGBA bytes, red and blue
+// swapped back when the texture is read (texture swizzle, OpenGL ES 3.0)
+static bool IsBGRA(GLenum format, GLenum type)
+{
+  return format == GL_BGRA && (type == GL_UNSIGNED_INT_8_8_8_8_REV || type == GL_UNSIGNED_BYTE);
+}
+
+static void SwapRedBlue(GLenum target)
+{
+  glTexParameteri(target, GL_TEXTURE_SWIZZLE_R, GL_BLUE);
+  glTexParameteri(target, GL_TEXTURE_SWIZZLE_B, GL_RED);
+}
+
+extern "C" void sm_gles_TexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height,
+  GLint border, GLenum format, GLenum type, const void *pixels)
+{
+  if (IsBGRA(format, type))
+  {
+    SwapRedBlue(target);
+    internalformat = GL_RGBA8;
+    format = GL_RGBA;
+    type = GL_UNSIGNED_BYTE;
+  }
+  glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+}
+
+extern "C" void sm_gles_TexSubImage2D(GLenum target, GLint level, GLint xoffset, GLint yoffset, GLsizei width,
+  GLsizei height, GLenum format, GLenum type, const void *pixels)
+{
+  if (IsBGRA(format, type))
+  {
+    SwapRedBlue(target);
+    format = GL_RGBA;
+    type = GL_UNSIGNED_BYTE;
+  }
+  glTexSubImage2D(target, level, xoffset, yoffset, width, height, format, type, pixels);
+}
